<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <meta name="theme-color" content="#e94560">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Томсон">
  <link rel="manifest" href="manifest.json">
  <link rel="apple-touch-icon" href="icon-192.png">
  <link rel="icon" type="image/png" href="icon-192.png">
  <title>Бронь · Фотостудия Томсон</title>
  <style>
    :root {
      --bg: #0f0f1a;
      --card: #1a1a2e;
      --accent: #e94560;
      --accent2: #0f3460;
      --text: #eee;
      --muted: #a0a0b0;
      --success: #2ecc71;
      --border: #2a2a40;
      --radius: 16px;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100dvh;
      padding: 12px;
      padding-bottom: 40px;
      line-height: 1.45;
    }
    .header {
      text-align: center;
      padding: 16px 0 20px;
    }
    .header h1 {
      font-size: 1.5rem;
      font-weight: 700;
      letter-spacing: -0.02em;
    }
    .header p {
      color: var(--muted);
      font-size: 0.85rem;
      margin-top: 4px;
    }
    .halls {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
      margin-bottom: 20px;
    }
    .hall-btn {
      background: var(--card);
      border: 2px solid var(--border);
      border-radius: var(--radius);
      padding: 14px 8px;
      color: var(--text);
      font-size: 0.95rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
      text-align: center;
    }
    .hall-btn.active {
      border-color: var(--accent);
      background: linear-gradient(135deg, #e9456033, #0f346033);
      box-shadow: 0 0 20px #e9456040;
    }
    .hall-btn small {
      display: block;
      font-size: 0.7rem;
      font-weight: 400;
      color: var(--muted);
      margin-top: 4px;
    }
    .card {
      background: var(--card);
      border-radius: var(--radius);
      padding: 18px;
      margin-bottom: 16px;
      border: 1px solid var(--border);
    }
    .card h2 {
      font-size: 1rem;
      margin-bottom: 14px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    label {
      display: block;
      font-size: 0.8rem;
      color: var(--muted);
      margin-bottom: 4px;
      margin-top: 12px;
    }
    label:first-of-type { margin-top: 0; }
    input, select, textarea {
      width: 100%;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 12px 14px;
      color: var(--text);
      font-size: 1rem;
      outline: none;
      transition: border 0.2s;
    }
    input:focus, select:focus, textarea:focus {
      border-color: var(--accent);
    }
    .row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }
    .preview {
      background: #12121f;
      border-radius: 12px;
      padding: 14px;
      font-size: 0.85rem;
      white-space: pre-wrap;
      max-height: 280px;
      overflow-y: auto;
      border: 1px solid var(--border);
      line-height: 1.5;
      word-break: break-word;
    }
    .actions {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-top: 14px;
    }
    .btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 14px;
      border: none;
      border-radius: 12px;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      transition: transform 0.15s, opacity 0.15s;
      color: #fff;
    }
    .btn:active { transform: scale(0.97); }
    .btn-wa { background: #25D366; }
    .btn-tg { background: #0088cc; }
    .btn-max { background: #6c5ce7; }
    .btn-copy { background: var(--accent2); }
    .btn-secondary {
      background: transparent;
      border: 1px solid var(--border);
      color: var(--text);
    }
    .tabs {
      display: flex;
      gap: 6px;
      margin-bottom: 16px;
      background: var(--bg);
      padding: 4px;
      border-radius: 12px;
    }
    .tab {
      flex: 1;
      padding: 10px;
      text-align: center;
      border-radius: 10px;
      font-weight: 600;
      font-size: 0.9rem;
      cursor: pointer;
      color: var(--muted);
      transition: all 0.2s;
    }
    .tab.active {
      background: var(--accent);
      color: #fff;
    }
    .section { display: none; }
    .section.active { display: block; }
    .toast {
      position: fixed;
      bottom: 24px;
      left: 50%;
      transform: translateX(-50%) translateY(100px);
      background: var(--success);
      color: #fff;
      padding: 12px 24px;
      border-radius: 30px;
      font-weight: 600;
      z-index: 100;
      transition: transform 0.3s;
      box-shadow: 0 8px 30px #0008;
    }
    .toast.show { transform: translateX(-50%) translateY(0); }
    .price-hint {
      font-size: 0.75rem;
      color: var(--muted);
      margin-top: 8px;
      padding: 8px 10px;
      background: #12121f;
      border-radius: 8px;
    }
    .install-banner {
      background: linear-gradient(135deg, #e94560, #0f3460);
      border-radius: var(--radius);
      padding: 14px;
      margin-bottom: 16px;
      display: none;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }
    .install-banner p { font-size: 0.9rem; }
    .install-banner button {
      background: #fff;
      color: #e94560;
      border: none;
      padding: 8px 16px;
      border-radius: 8px;
      font-weight: 700;
      white-space: nowrap;
      cursor: pointer;
    }
    @media (min-width: 480px) {
      body { max-width: 480px; margin: 0 auto; }
    }
  </style>
</head>
<body>
  <div class="header">
    <h1>📸 Фотостудия Томсон</h1>
    <p>Быстрое бронирование залов</p>
  </div>

  <div class="install-banner" id="installBanner">
    <p>Установить на главный экран</p>
    <button id="installBtn">Установить</button>
  </div>

  <div class="halls">
    <button class="hall-btn active" data-hall="sphere">
      Сфера
      <small>оф. 311</small>
    </button>
    <button class="hall-btn" data-hall="edison">
      Эдисон
      <small>оф. 305</small>
    </button>
    <button class="hall-btn" data-hall="vegas">
      Вегас
      <small>оф. 304</small>
    </button>
  </div>

  <div class="card">
    <h2>📋 Данные клиента</h2>
    <label>Имя</label>
    <input type="text" id="name" placeholder="Иван" autocomplete="name">

    <label>Телефон</label>
    <input type="tel" id="phone" placeholder="+7 923 000-00-00" inputmode="tel">

    <label>Количество гостей</label>
    <input type="number" id="guests" placeholder="5" min="1" max="30" inputmode="numeric">

    <div class="row">
      <div>
        <label>Дата</label>
        <input type="date" id="date">
      </div>
      <div>
        <label>С</label>
        <input type="time" id="timeFrom" value="17:00">
      </div>
    </div>
    <label>До</label>
    <input type="time" id="timeTo" value="18:00">

    <div class="price-hint" id="priceHint"></div>
  </div>

  <div class="card">
    <div class="tabs">
      <div class="tab active" data-tab="booking">Бронь</div>
      <div class="tab" data-tab="confirm">Подтверждение</div>
    </div>

    <div class="section active" id="sec-booking">
      <h2>✉️ Сообщение о брони</h2>
      <div class="preview" id="previewBooking" contenteditable="true"></div>
      <div class="actions">
        <button class="btn btn-wa" onclick="send('wa','booking')">WhatsApp</button>
        <button class="btn btn-tg" onclick="send('tg','booking')">Telegram</button>
        <button class="btn btn-max" onclick="send('max','booking')">MAX (копировать)</button>
        <button class="btn btn-copy" onclick="copyText('booking')">📋 Скопировать текст</button>
      </div>
    </div>

    <div class="section" id="sec-confirm">
      <h2>✅ Подтверждение брони</h2>
      <div class="preview" id="previewConfirm" contenteditable="true"></div>
      <div class="actions">
        <button class="btn btn-wa" onclick="send('wa','confirm')">WhatsApp</button>
        <button class="btn btn-tg" onclick="send('tg','confirm')">Telegram</button>
        <button class="btn btn-max" onclick="send('max','confirm')">MAX (копировать)</button>
        <button class="btn btn-copy" onclick="copyText('confirm')">📋 Скопировать текст</button>
      </div>
    </div>
  </div>

  <div class="toast" id="toast">Скопировано</div>

  <script>
    // ===== Данные залов =====
    const halls = {
      sphere: {
        name: 'Сфера',
        office: '311',
        prices: '1-9 чел/час 1500₽\n10-15 чел/час 1700₽\n16-30 чел/час 1900₽',
        cards: `Карта Тинькофф:
2200700146125280
Карта Сбербанк:
2202206203163030
По номеру:
 79234123330
Держатель - Алексей Геннадьевич Н.`,
        shoe: `👞 Подготовьте чистую сменную обувь
 (у нас можно ходить босиком) подошву необходимо заклеить малярным/бумажным скотчем. Вы можете сделать это заранее дома или в студии (малярный скотч предоставляется).
Мы просим заклеивать только черную подошву, так как она оставляет следы на поверхности циклорамы, даже если обувь новая.`,
        confirmShoe: `👟 Пожалуйста, подготовьте чистую сменную обувь(можно босиком).
Для съёмок на циклораме, цветную/черную подошву обуви, необходимо заклеить прозрачным или бумажным скотчем. Вы можете сделать это заранее дома или в студии (бумажный скотч предоставляется).
обувь может оставляет следы на поверхности циклорамы, даже если она новая.`,
        confirmExtra: `Студийный час 55 минут.
Вы заходите ровно в забронированное время и выходите за 5 минут до его окончания, оставшиеся 5 минут отводятся на сдачу/приемку помещения и подготовку зала для следующих клиентов.
Подготовка фонов оборудования моделей, одежды, обуви, а также переодевание является частью съемочного процесса.`
      },
      edison: {
        name: 'Эдисон',
        office: '305',
        prices: '1-9 чел/час 1600₽\n10-15 чел/час 1800₽\n16-30 чел/час 2000₽',
        cards: `Карта Тинькофф:
2200700146125280
Карта Сбербанк:
2202206203163030
По номеру:
 79234123330
Держатель - Алексей Геннадьевич Н.`,
        shoe: `👞 Подготовьте чистую сменную обувь
 (у нас можно ходить босиком)`,
        confirmShoe: `👟 Пожалуйста, подготовьте чистую сменную обувь(можно босиком) Подошва должна быть помыта или хорошо протерта.`,
        confirmExtra: `Студийный час 55 минут
Вы заходите ровно в забронированное время и выходите за 5 минут до его окончания, оставшиеся 5 минут отводятся на осмотр помещения и подготовку зала для следующих клиентов.
Подготовка фонов и оборудования является частью съемочного процесса. Подготовка моделей, одежды, а также переодевание, также входит в студийный час 55 минут.`
      },
      vegas: {
        name: 'Вегас',
        office: '304',
        prices: '1-5 чел/час 1300₽\n6-10 чел/час 1500₽\n11-15 чел/час 3000₽',
        cards: `Карта Сбербанк:
 2202206203163030
Карта Тинькофф:
 2200700791855512
 По номеру:
 +79234123330
Держатель - Алексей Н.`,
        shoe: `👞 Подготовьте чистую сменную обувь
 (у нас можно ходить босиком)
В Зале Вегас нельзя танцевать в обуви на каблуках
Обязательно ознакомьесь с нашими правилами.`,
        confirmShoe: `👟 Пожалуйста, подготовьте чистую сменную обувь(можно босиком) Подошва должна быть помыта или хорошо протерта.`,
        confirmExtra: `Студийный час 55 минут
Вы заходите ровно в забронированное время и выходите за 5 минут до его окончания, оставшиеся 5 минут отводятся на осмотр помещения и подготовку зала для следующих клиентов.
Подготовка фонов и оборудования является частью съемочного процесса. Подготовка моделей, одежды, а также переодевание, также входит в студийный час 55 минут.`
      }
    };

    let currentHall = 'sphere';
    let deferredPrompt = null;

    // ===== UI =====
    document.querySelectorAll('.hall-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.hall-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentHall = btn.dataset.hall;
        updatePreviews();
        updatePriceHint();
      });
    });

    document.querySelectorAll('.tab').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
        tab.classList.add('active');
        document.getElementById('sec-' + tab.dataset.tab).classList.add('active');
      });
    });

    ['name','phone','guests','date','timeFrom','timeTo'].forEach(id => {
      document.getElementById(id).addEventListener('input', () => {
        updatePreviews();
        updatePriceHint();
      });
    });

    // ===== Форматирование =====
    function formatDate(iso) {
      if (!iso) return 'ДД.ММ.ГГГГ';
      const [y,m,d] = iso.split('-');
      return `${d}.${m}.${y}`;
    }

    function formatTime(t) {
      return t || '00:00';
    }

    function normalizePhone(raw) {
      let p = (raw || '').replace(/\D/g, '');
      if (p.startsWith('8') && p.length === 11) p = '7' + p.slice(1);
      if (p.startsWith('7') && p.length === 11) return p;
      if (p.length === 10) return '7' + p;
      return p;
    }

    function getPhoneForLink() {
      return normalizePhone(document.getElementById('phone').value);
    }

    // ===== Генерация текстов =====
    function buildBooking() {
      const h = halls[currentHall];
      const date = formatDate(document.getElementById('date').value);
      const from = formatTime(document.getElementById('timeFrom').value);
      const to = formatTime(document.getElementById('timeTo').value);

      if (currentHall === 'vegas') {
        return `Фотостудия Томсон
Зал "${h.name}" ${h.office} офис
Мы ждём Вас
${date}
с ${from} до ${to}
Для подтверждения брони, обязательно пришлите чек в этот диалог.
*Бронь автоматически подтвердится*
(Чек должен содержать информацию о переводе, дату и номер операции)
*Предоплата 100%*
Стоимость:
${h.prices}
🔴подробные ПРАВИЛА и ЦЕНЫ тут:
👉http://томсон.рф/pravila_i_cena
..........................................................
${h.cards}
❗️Внося предоплату Вы соглашаетесь с правилами фотостудии
ВАЖНО:
Перенос или отмена возможна не позднее 48 часов до времени брони.
При отмене позднее предоплата сгорает.
Кол-во гостей ограничено, подробнее в наших правилах, на сайте студии.
${h.shoe}
Адрес и как нас найти:
http://томсон.рф/kak-najti
Ул. Красноармейская, 101а
3 этаж, оф. ${h.office}
❗️Сообщите нам, что передумали, даже если не внесёте предоплату.`;
      }

      // Сфера и Эдисон
      return `Фотостудия Томсон
Зал "${h.name}" ${h.office} офис
Мы ждём Вас
${date}
с ${from} до ${to}
Для подтверждения брони, обязательно пришлите чек в этот диалог.
*Бронь автоматически подтвердится*
(Чек должен содержать информацию о переводе, дату и номер операции)
*Предоплата 100%*
Стоимость:
${h.prices}
❗️Внося предоплату Вы соглашаетесь с *ПРАВИЛАМИ и ЦЕНАМИ* фотостудии
http://томсон.рф/pravila_i_cena
...................................................
${h.cards}
ВАЖНО:
Перенос возможен не позднее 48 часов до времени брони.
При отмене позднее предоплата сгорает.
${h.shoe}
*Адрес и как нас найти:*
http://томсон.рф/kak-najti
Ул. Красноармейская, 101а
3 этаж, оф. ${h.office}
❗️Сообщите нам, что передумали, даже если не внесёте предоплату.
Мы не снимаем бронь без предупреждения.`;
    }

    function buildConfirm() {
      const h = halls[currentHall];
      const date = formatDate(document.getElementById('date').value);
      const from = formatTime(document.getElementById('timeFrom').value);
      const to = formatTime(document.getElementById('timeTo').value);

      return `✅Бронь подтверждена.
${h.confirmExtra}
${h.confirmShoe}
❗️Внося предоплату Вы соглашаетесь с ПРАВИЛАМИ и ЦЕНАМИ фотостудии
https://томсон.рф/pravila_i_cena
ВАЖНО: Перенос возможен не позднее 48 часов до времени брони.
При отмене позднее предоплата сгорает.
📍Адрес и как нас найти:
https://томсон.рф/kak-najti
Ул. Красноармейская, 101а
3 этаж, ${h.office} офис, зал ${h.name}`;
    }

    function updatePreviews() {
      document.getElementById('previewBooking').textContent = buildBooking();
      document.getElementById('previewConfirm').textContent = buildConfirm();
    }

    function updatePriceHint() {
      const h = halls[currentHall];
      const g = parseInt(document.getElementById('guests').value) || 0;
      let hint = `Цены зала «${h.name}»:\n${h.prices}`;
      if (g > 0) {
        // простая подсказка
        if (currentHall === 'vegas') {
          if (g <= 5) hint += `\n→ для ${g} чел ≈ 1300₽/час`;
          else if (g <= 10) hint += `\n→ для ${g} чел ≈ 1500₽/час`;
          else hint += `\n→ для ${g} чел ≈ 3000₽/час`;
        } else {
          const base = currentHall === 'sphere' ? 1500 : 1600;
          if (g <= 9) hint += `\n→ для ${g} чел ≈ ${base}₽/час`;
          else if (g <= 15) hint += `\n→ для ${g} чел ≈ ${base + 200}₽/час`;
          else hint += `\n→ для ${g} чел ≈ ${base + 400}₽/час`;
        }
      }
      document.getElementById('priceHint').textContent = hint;
    }

    // ===== Отправка =====
    function getCurrentText(type) {
      const el = document.getElementById(type === 'booking' ? 'previewBooking' : 'previewConfirm');
      return el.innerText || el.textContent;
    }

    function showToast(msg = 'Скопировано') {
      const t = document.getElementById('toast');
      t.textContent = msg;
      t.classList.add('show');
      setTimeout(() => t.classList.remove('show'), 2200);
    }

    function copyText(type) {
      const text = getCurrentText(type);
      navigator.clipboard.writeText(text).then(() => showToast('Текст скопирован')).catch(() => {
        // fallback
        const ta = document.createElement('textarea');
        ta.value = text;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
        showToast('Текст скопирован');
      });
    }

    function send(messenger, type) {
      const text = getCurrentText(type);
      const phone = getPhoneForLink();

      if (!phone || phone.length < 11) {
        showToast('Укажите телефон клиента');
        document.getElementById('phone').focus();
        return;
      }

      const encoded = encodeURIComponent(text);

      if (messenger === 'wa') {
        // WhatsApp
        const url = `https://wa.me/${phone}?text=${encoded}`;
        window.open(url, '_blank');
      } else if (messenger === 'tg') {
        // Telegram — поддерживает phone + text
        const url = `https://t.me/+${phone}?text=${encoded}`;
        window.open(url, '_blank');
      } else if (messenger === 'max') {
        // MAX не имеет публичного deep-link по номеру
        navigator.clipboard.writeText(text).then(() => {
          showToast('Текст скопирован. Откройте MAX и найдите по номеру');
          // Попытка открыть приложение
          setTimeout(() => {
            window.location.href = 'https://max.ru';
          }, 600);
        }).catch(() => {
          showToast('Скопируйте текст вручную');
        });
      }
    }

    // ===== PWA install =====
    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredPrompt = e;
      document.getElementById('installBanner').style.display = 'flex';
    });

    document.getElementById('installBtn').addEventListener('click', async () => {
      if (!deferredPrompt) return;
      deferredPrompt.prompt();
      const { outcome } = await deferredPrompt.userChoice;
      if (outcome === 'accepted') {
        document.getElementById('installBanner').style.display = 'none';
      }
      deferredPrompt = null;
    });

    // Service Worker
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('./sw.js').catch(console.error);
    }

    // Init
    // Сегодняшняя дата по умолчанию
    const today = new Date();
    document.getElementById('date').value = today.toISOString().slice(0,10);
    updatePreviews();
    updatePriceHint();
  </script>
</body>
</html>